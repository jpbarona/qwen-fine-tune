# Copy this file to /home/opencode/.config/mlflow/env and fill in the values.
# Keep the copy at mode 0600. It holds the object storage key that the MLflow
# server uses for the artifact proxy and that the backup uses for uploads.
# The unit reads the file through EnvironmentFile, so plain NAME=value lines.

MLFLOW_S3_ENDPOINT_URL=https://<location>.your-objectstorage.com
AWS_ACCESS_KEY_ID=replace-with-the-access-key
AWS_SECRET_ACCESS_KEY=replace-with-the-secret-key
AWS_DEFAULT_REGION=<location>
